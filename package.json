{
  "name": "autonomous-coconuts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "postinstall": "node scripts/copy-cesium.mjs",
    "test": "node --test tests/demo-data.test.ts web/tests/*.test.ts"
  },
  "dependencies": {
    "cesium": "^1.135.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
