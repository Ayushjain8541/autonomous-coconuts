{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "insights-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "analysis_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "fixture",
        "unavailable"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "fact_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "field": {
                  "enum": [
                    "predicted_pc",
                    "reported_pc",
                    "miss_distance_m",
                    "relative_speed_mps",
                    "time_to_tca_hours",
                    "severity",
                    "flag_reasons",
                    "prediction_status",
                    "geometry"
                  ]
                }
              },
              "required": [
                "event_id",
                "field"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "event_id",
          "summary",
          "fact_refs",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "status",
    "items",
    "warnings"
  ],
  "additionalProperties": false
}
